# =============================================================================
# bigsur-streaming infrastructure scripts — shared config
# Copy to `.env` and edit. Sourced by every setup-*-remote.sh wrapper.
# Wrappers forward these to the remote box via env vars on the ssh invocation.
# =============================================================================

# -----------------------------------------------------------------------------
# SSH
# -----------------------------------------------------------------------------
# User to SSH into target boxes as. The setup scripts must run as root, so this
# user needs passwordless sudo OR be root itself. Run common/bootstrap-remote.sh
# ONCE per fresh box to create this sudo user (NEW_USER below), then set
# SSH_USER to it. The setup-*-remote.sh wrappers add `sudo -E` automatically
# when SSH_USER != root.
SSH_USER=root

# -----------------------------------------------------------------------------
# Bootstrap (common/bootstrap-remote.sh) — first-touch on a fresh box
# -----------------------------------------------------------------------------
# Non-root sudo user that bootstrap creates and copies root's SSH keys to.
# After bootstrap, deploy with: setup-*-remote.sh -u $NEW_USER <host>
NEW_USER=deploy

# VPC CIDR that SSH (22/tcp) is allowed from after bootstrap enables UFW.
# Must cover HAPROXY_VPC_IP / SRS_VPC_IP below.
VPC_SUBNET=10.40.96.0/20

# Extra CIDR allowed to SSH (operator/bastion public IP). Leave empty to allow
# SSH only from the VPC. Set e.g. 1.2.3.4/32 when bootstrapping over the public
# internet, or bootstrap will refuse to enable UFW (it would lock you out).
BASTION_CIDR=

# Timezone applied to every box.
TIMEZONE=Asia/Ho_Chi_Minh

# Tailscale (optional). Leave TAILSCALE_AUTH_KEY empty to skip entirely.
# When set, bootstrap installs Tailscale and joins the tailnet with --ssh.
TAILSCALE_AUTH_KEY=
TAILSCALE_TAGS=
# Per-node opt-out without unsetting the shared key above (1 = skip).
SKIP_TAILSCALE=0

# -----------------------------------------------------------------------------
# Network topology — VPC + public IPs
# -----------------------------------------------------------------------------
# HAProxy edge box VPC IP (where stream-auth also runs by default).
HAPROXY_VPC_IP=10.40.96.3

# SRS origin box VPC IP.
SRS_VPC_IP=10.40.96.4

# HAProxy edge public IP (informational; printed in STREAM_KEYS.txt).
HAPROXY_PUBLIC_IP=45.76.145.205

# -----------------------------------------------------------------------------
# HAProxy / TLS (required for prod; set ALLOW_NO_TLS=1 to skip in dev)
# -----------------------------------------------------------------------------
# OBS push endpoint — MUST be grey-cloud DNS (CF does not proxy 1935/1936).
PUBLISH_HOST=bspush.example.com

# HLS origin pulled by BunnyCDN — recommend grey-cloud DNS.
PLAYBACK_ORIGIN_HOST=origin.example.com

# Email for the Let's Encrypt certificate. setup-haproxy.sh issues ONE SAN
# cert covering PLAYBACK_ORIGIN_HOST (:443 HLS, pulled directly by BunnyCDN)
# and PUBLISH_HOST (:1936 RTMPS for OBS) via an HTTP-01 challenge. Both
# A-records must point at the HAProxy box and public port 80 must be reachable.
# Required for production; only skippable with ALLOW_NO_TLS=1.
LETSENCRYPT_EMAIL=

# Skip TLS entirely (dev only). DO NOT use in production.
ALLOW_NO_TLS=0

# BunnyCDN edge IP allowlist on HLS pull paths.
# off (default) | monitor (log only) | enforce (deny non-Bunny IPs with 403)
BUNNY_EDGE_GUARD=off

# -----------------------------------------------------------------------------
# stream-auth (NestJS) overrides — leave blank to accept defaults
# -----------------------------------------------------------------------------
# stream-auth binds here. Default: $HAPROXY_VPC_IP (colocated with haproxy).
# Override only if running stream-auth on a separate box.
STREAM_AUTH_VPC_IP=

# Port stream-auth listens on (HAProxy backend points here).
STREAM_AUTH_PORT=3000

# SRS RTMP app name. OBS pushes rtmp://<host>/<PUBLISH_APP>/<stream> and SRS
# writes HLS to /<PUBLISH_APP>/<stream>.m3u8 — so this is also the BunnyCDN
# token path segment. Must match across stream-auth and any playback signer.
PUBLISH_APP=luckylive

# SRS HTTP API basic-auth credentials. setup-stream-auth.sh writes these into
# /opt/streaming-auth/.env AND /root/STREAM_KEYS.txt. setup-srs.sh reads them
# (from env or STREAM_KEYS.txt on the haproxy box) when configuring SRS.
SRS_API_USER=admin
SRS_API_PASS=

# -----------------------------------------------------------------------------
# SRS
# -----------------------------------------------------------------------------
# SRS git tag to build. Do NOT use 'develop' in production.
SRS_VERSION=v6.0-r0
