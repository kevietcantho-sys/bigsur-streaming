# =============================================================================
# bigsur-streaming infrastructure scripts — shared config
# Copy to `.env` and edit. Sourced by every setup-*-remote.sh wrapper.
# Wrappers forward these to the remote box via env vars on the ssh invocation.
# =============================================================================

# -----------------------------------------------------------------------------
# SSH
# -----------------------------------------------------------------------------
# User to SSH into target boxes as. The setup scripts must run as root, so this
# user needs passwordless sudo OR be root itself.
SSH_USER=root

# -----------------------------------------------------------------------------
# Network topology — VPC + public IPs
# -----------------------------------------------------------------------------
# HAProxy edge box VPC IP (where stream-auth also runs by default).
HAPROXY_VPC_IP=10.40.96.3

# SRS origin box VPC IP.
SRS_VPC_IP=10.40.96.4

# HAProxy edge public IP (informational; printed in STREAM_KEYS.txt).
HAPROXY_PUBLIC_IP=45.76.145.205

# -----------------------------------------------------------------------------
# HAProxy / TLS (required for prod; set ALLOW_NO_TLS=1 to skip in dev)
# -----------------------------------------------------------------------------
# OBS push endpoint — MUST be grey-cloud DNS (CF does not proxy 1935/1936).
PUBLISH_HOST=bspush.example.com

# HLS origin pulled by BunnyCDN — recommend grey-cloud DNS.
PLAYBACK_ORIGIN_HOST=origin.example.com

# Cloudflare Origin Certificate path on the haproxy box (upload before running).
SSL_CERT_PATH=/etc/ssl/cloudflare/origin.pem
SSL_KEY_PATH=/etc/ssl/cloudflare/origin.key

# If set, setup-haproxy.sh issues a Let's Encrypt cert for PUBLISH_HOST and
# binds it on :1936 so OBS (which checks public CA roots) can do RTMPS.
# Requires public port 80 reachable for HTTP-01 challenge.
LETSENCRYPT_EMAIL=

# Skip TLS entirely (dev only). DO NOT use in production.
ALLOW_NO_TLS=0

# BunnyCDN edge IP allowlist on HLS pull paths.
# off (default) | monitor (log only) | enforce (deny non-Bunny IPs with 403)
BUNNY_EDGE_GUARD=off

# -----------------------------------------------------------------------------
# stream-auth (NestJS) overrides — leave blank to accept defaults
# -----------------------------------------------------------------------------
# stream-auth binds here. Default: $HAPROXY_VPC_IP (colocated with haproxy).
# Override only if running stream-auth on a separate box.
STREAM_AUTH_VPC_IP=

# Port stream-auth listens on (HAProxy backend points here).
STREAM_AUTH_PORT=3000

# SRS HTTP API basic-auth credentials. setup-stream-auth.sh writes these into
# /opt/streaming-auth/.env AND /root/STREAM_KEYS.txt. setup-srs.sh reads them
# (from env or STREAM_KEYS.txt on the haproxy box) when configuring SRS.
SRS_API_USER=admin
SRS_API_PASS=

# -----------------------------------------------------------------------------
# SRS
# -----------------------------------------------------------------------------
# SRS git tag to build. Do NOT use 'develop' in production.
SRS_VERSION=v6.0-r0
